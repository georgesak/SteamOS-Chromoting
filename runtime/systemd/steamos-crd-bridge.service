[Unit]
Description=SteamOS CRD Session Capture & uinput Bridge
PartOf=steamos-crd.target
Requires=steamos-crd-xvfb.service
After=steamos-crd-xvfb.service
ConditionPathExists=%h/.local/share/steamos-chromoting/bin/steamos-crd-bridge

[Service]
Type=simple
UnsetEnvironment=WAYLAND_DISPLAY XAUTHORITY DISPLAY
Environment=STEAMOS_CRD_DISPLAY=:20
Environment=RUST_LOG=info
EnvironmentFile=-%h/.config/steamos-chromoting/settings.env
ExecStart=%h/.local/share/steamos-chromoting/bin/steamos-crd-bridge
Restart=always
RestartSec=2

[Install]
WantedBy=steamos-crd.target
